<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)../../../../refs/game</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KSA" HintPath="$(GameDir)/KSA.dll" Private="false" />
    <Reference Include="Brutal.Numerics" HintPath="$(GameDir)/Brutal.Numerics.dll" Private="false" />
    <Reference Include="BepuUtilities" HintPath="$(GameDir)/BepuUtilities.dll" Private="false" />
  </ItemGroup>
</Project>
